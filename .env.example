# Django Secret Key — generate a secure random key for production
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secure-random-secret-key-here

# Django Debug Mode — set to 0 for production on Railway
DJANGO_DEBUG=0

# Production HTTPS hardening (Railway terminates TLS at the proxy)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable only after every subdomain is confirmed HTTPS-only and preload-ready.
DJANGO_SECURE_HSTS_PRELOAD=0

# Allowed Hosts — add your Railway domain and any custom domains
# Example: your-app.railway.app,your-custom-domain.com
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app,internet.home.arpa,10.10.10.254,localhost,127.0.0.1

# CSRF Trusted Origins — must include full https:// URL of your Railway domain
# Example: https://your-app.up.railway.app,https://your-custom-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,http://internet.home.arpa:8000,http://10.10.10.254:8000,http://localhost:8000

# Unique names prevent cookie collisions with other Django apps on this host.
DJANGO_SESSION_COOKIE_NAME=jsinternet_sessionid
DJANGO_CSRF_COOKIE_NAME=jsinternet_csrftoken

# Database URL — Railway automatically sets this variable
# Leave blank for local development with SQLite
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# Email Configuration (SMTP) — for sending emails from Railway
# Example for Gmail (use App Password, not regular password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Default From Email — email address that appears as sender
DEFAULT_FROM_EMAIL=JS Internet Services <noreply@yourdomain.com>

# Server Email — for error notifications
SERVER_EMAIL=admin@yourdomain.com
INTEGRATION_API_PAGE_SIZE=50
INTEGRATION_API_BURST_RATE=30/min
INTEGRATION_API_SUSTAINED_RATE=500/day
